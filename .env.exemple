# ============================================================
# Démo du standardiste vocal IA — informations à remplir
# ============================================================
# 1. Remplace chaque valeur après le signe =, sans guillemets ni espaces autour.
# 2. Enregistre le fichier, puis dis-le à Claude : il reconstruit le circuit et le met à jour dans n8n.
# Ce fichier reste sur ton ordinateur. Ne l'envoie à personne.

# --- L'entreprise de la démo (fictive, cas Plomberie Garnier du catalogue)
NOM_ENTREPRISE=Plomberie Garnier
# Numéro lu à l'appelant pour annuler ou déplacer un rendez-vous (format libre)
NUMERO_AFFICHE=01 23 45 67 89

# --- Tes numéros pour la démo (format international, ex. +33612345678)
# Ton portable : reçoit le SMS d'alerte quand l'agent détecte une urgence
NUMERO_DIRIGEANT=+33XXXXXXXXX
# Ton numéro Twilio qui envoie les SMS (laisse tel quel si tu n'en as pas : les SMS seront sautés)
NUMERO_SMS_TWILIO=+33XXXXXXXXX

# --- Google
# Identifiant de l'agenda « Démo Garnier » (Google Agenda > Paramètres de l'agenda > Intégrer l'agenda > ID de l'agenda)
# ou « primary » pour ton agenda principal
AGENDA_ID=primary
# Adresse complète du Google Sheets qui reçoit le journal des appels (avec un onglet nommé « Appels »)
GOOGLE_SHEET_URL=

# --- Alertes sur ton téléphone (ntfy, déjà installé sur ton serveur)
# Abonne-toi à ce sujet dans l'appli ntfy pour recevoir les urgences
NTFY_URL=https://alertes.vorchex.tech/garnier-urgences
# Identifiant n8n « ntfy VorcheX » (jeton d’accès ntfy) : son numéro, que Claude remplit après sa création. Pas de jeton ici.
NTFY_IDENTIFIANT=

# --- Clés de sécurité, générées automatiquement : ne pas modifier
# Clé de la fin d’appel : collée EN CLAIR à la fin de l’adresse du webhook Retell (…/vx-batiment-fin-appel?cle=CLÉ) ; Retell ne remplace pas les variables à cet endroit
CLE_FIN_APPEL=(générée automatiquement)
# Clé des fonctions : copiée dans Retell (variable par défaut cle_fonctions), ajoutée aux adresses des 3 fonctions (?cle=)
CLE_FONCTIONS=(générée automatiquement)

# --- Clés API : NE PAS LES METTRE ICI
# Anthropic, Twilio et Google se saisissent directement dans n8n > Identifiants (Credentials),
# où elles sont chiffrées. Retell : clé dans ton compte Retell, pas nécessaire dans ce fichier.

# --- Mode de la démo
# demo   : agenda et journal dans les tables de données de n8n (aucun compte Google à brancher) ; mettre leurs ids ci-dessous
# google : Google Agenda + Google Sheets (pour un vrai client)
MODE_AGENDA=demo
TABLE_RDV=
TABLE_JOURNAL=
# oui quand l identifiant Twilio est créé dans n8n ; non = SMS sautés proprement
SMS_ACTIFS=non

# Numéro de l’identifiant n8n « Anthropic account » (pas la clé API : elle reste dans n8n)
ANTHROPIC_IDENTIFIANT=
